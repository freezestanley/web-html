  "blockPolicy": {
    "description": "blocked=true 时仅允许流向 unblock 相关 gate；unblockTargets 列出各 gate 被 block 时可回退的目标",
    "unblockTargets": {
      "G2_REQUIREMENTS_COLLECTED": ["G1_PROJECT_IDENTIFIED"],
      "G3_DESIGN_BRIEF_READY": ["G2_REQUIREMENTS_COLLECTED"],
      "G4_DESIGN_COMPLETED": ["G3_DESIGN_BRIEF_READY"],
      "G5_CDN_VALIDATED": ["G4_DESIGN_COMPLETED"],
      "G6_DIST_ASSEMBLED": ["G4_DESIGN_COMPLETED", "G5_CDN_VALIDATED"],
      "G7_CDP_PASSED": ["G6_DIST_ASSEMBLED"],
      "G8_USER_CONFIRMED": ["G7_CDP_PASSED", "G6_DIST_ASSEMBLED"],
      "G9_PUBLISH_READY": ["G8_USER_CONFIRMED", "G7_CDP_PASSED"]
    }
  }
}

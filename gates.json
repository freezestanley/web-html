{
  "version": "v1",
  "gates": [
    "G1_PROJECT_IDENTIFIED",
    "G2_REQUIREMENTS_COLLECTED",
    "G3_DESIGN_BRIEF_READY",
    "G4_DESIGN_COMPLETED",
    "G5_CDN_VALIDATED",
    "G6_DIST_ASSEMBLED",
    "G7_CDP_PASSED",
    "G8_USER_CONFIRMED",
    "G9_PUBLISH_READY",
    "DONE"
  ],
  "transitions": {
    "G1_PROJECT_IDENTIFIED": ["G2_REQUIREMENTS_COLLECTED"],
    "G2_REQUIREMENTS_COLLECTED": ["G3_DESIGN_BRIEF_READY"],
    "G3_DESIGN_BRIEF_READY": ["G4_DESIGN_COMPLETED"],
    "G4_DESIGN_COMPLETED": ["G5_CDN_VALIDATED"],
    "G5_CDN_VALIDATED": ["G6_DIST_ASSEMBLED"],
    "G6_DIST_ASSEMBLED": ["G7_CDP_PASSED"],
    "G7_CDP_PASSED": ["G8_USER_CONFIRMED", "G6_DIST_ASSEMBLED"],
